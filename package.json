{
  "name": "browser-tetris",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "tsc --noEmit && vite build && node scripts/third-party-notices.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "browsers:install": "node scripts/browser-env.mjs install",
    "test:e2e": "node scripts/run-browser-tests.mjs",
    "test:e2e:prod": "node scripts/run-browser-tests.mjs --production",
    "package:release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/sql.js": "1.4.9",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "sql.js": "1.14.2"
  }
}
